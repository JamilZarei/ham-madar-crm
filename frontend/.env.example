# Copy into frontend/.env.local for local setup.
# combined runs the UI and API together. split compiles the HTTP gateway instead.
CRM_FRONTEND_MODE=combined

# Required at runtime for split only. Example: http://127.0.0.1:3001
# Use the API service origin (without path, credentials, query or fragment).
CRM_BACKEND_URL=

# Browser requests use relative /api paths. No NEXT_PUBLIC_* values are required.
