{
  "name": "hamsir-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev frontend --webpack",
    "build": "next build frontend --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "next start frontend",
    "dev:backend": "next dev backend --webpack --port 3001",
    "build:backend": "next build backend --webpack",
    "start:backend": "next start backend",
    "postinstall": "npm run db:generate",
    "worker": "tsx backend/worker/index.ts",
    "db:generate": "prisma generate --config database/prisma.config.ts",
    "db:validate": "prisma validate --config database/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config database/prisma.config.ts",
    "db:seed": "prisma db seed --config database/prisma.config.ts",
    "db:provision-password": "tsx database/scripts/provision-password.ts",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:db": "tsx database/scripts/test-database.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/vazirmatn": "^5.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.0",
    "bullmq": "6.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "^4.1.0-0",
    "dotenv": "18.0.10",
    "input-otp": "^1.4.2",
    "ioredis": "6.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-is": "^19.2.0",
    "recharts": "^3.5.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "postcss": "^8.5.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
