{
  "compilerOptions": {
    "target": "ES2019", "lib": ["dom", "dom.iterable", "esnext"], "strict": true,
    "allowJs": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true,
    "isolatedModules": true, "jsx": "react-jsx", "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/*"],
      "@backend/*": ["./backend/*"],
      "@database/*": ["./database/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "frontend/next-env.d.ts", "frontend/**/*.ts", "frontend/**/*.tsx",
    "frontend/.next/types/**/*.ts", "frontend/.next/dev/types/**/*.ts",
    "backend/**/*.ts", "database/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
