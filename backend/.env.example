# Local: backend/.env.development.local. Production: use server environment / secret store.
# Runtime role with RLS, never the migration/owner role.
DATABASE_URL=
# Browser-facing frontend origin. Use the exact HTTPS origin in production.
APP_ORIGIN=
# At least 32 characters of independently generated secret material.
OTP_SECRET=
# Set mock for local development only.
SMS_PROVIDER=
# Optional. Set only when a trusted ingress strips and replaces this request header.
TRUSTED_CLIENT_IP_HEADER=
# Optional signed SMS callback configuration.
SMS_WEBHOOK_SECRET=
SMS_WEBHOOK_ACCOUNT=
SMS_WEBHOOK_WORKSPACE_ID=
# Worker only. redis is the production transport. postgres-local is development only.
WORKER_TRANSPORT=redis
REDIS_URL=
